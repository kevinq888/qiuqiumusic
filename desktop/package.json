{
  "name": "weimo-music-desktop",
  "version": "1.2.11",
  "private": true,
  "description": "未末音乐本地桌面播放器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "generate:icons": "node generate-icons.js",
    "build:mac": "node scripts/build-desktop.cjs mac",
    "build:win": "node scripts/build-desktop.cjs win",
    "build:all": "node scripts/build-desktop.cjs all",
    "test:local": "node scripts/test-local.cjs",
    "test:update": "node --test scripts/update.test.cjs scripts/update-poller.test.cjs",
    "test:audio": "node --test scripts/audio-recovery.test.cjs",
    "test:media": "electron scripts/test-cached-m4a.cjs"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.weimo.music.desktop",
    "productName": "未末音乐",
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "app-icon.png",
      "tray-icon.png",
      "update/**/*"
    ],
    "icon": "app-icon.png",
    "mac": {
      "icon": "app-icon.png",
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "artifactName": "未末音乐-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName}",
      "artifactName": "未末音乐-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "未末音乐-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "..",
        "to": "backend",
        "filter": [
          "server.js",
          "package.json",
          "README.md",
          "src/**/*.js",
          "public/**/*",
          "data/seed.json",
          "data/covers.json"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
